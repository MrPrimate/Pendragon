<form class="Pendragon">
  <div class="actor-roll">
    <img class="open-actor" src="{{image}}" width="50" data-tooltip="{{name}}"/>
    <div class="roll-details">
      <div class="header">
        <span class="name">{{name}} - {{actionLabel}}</span>
      </div>
    </div>
  </div>
  <p>{{message}}</p>
</form>
