<section class="Pendragon" id="family-input-form">
  <br>
  <div class="familyCreate">
    <div></div>
    <div class="stat-name bold centre">{{localize 'PEN.familyRelationship.father'}}</div>
    <div></div>
    <div class="stat-name bold centre">{{localize 'PEN.familyRelationship.mother'}}</div>

    <label class="new-row stat-name" data-tooltip="{{localize 'PEN.addParentsHint'}}">{{localize "PEN.name"}}</label>
    <div class="name-with-roll">
      <input data-handle-change class="stat-name centre" type="text" value="" name="familyName1">
      <a class="random-name" data-index="1" data-tooltip="{{localize 'PEN.randomName'}}"><i class="fas fa-dice"></i></a>
    </div>
    <div></div>
    <div class="name-with-roll">
      <input data-handle-change class="stat-name centre" type="text" value="" name="familyName2">
      <a class="random-name" data-index="2" data-tooltip="{{localize 'PEN.randomName'}}"><i class="fas fa-dice"></i></a>
    </div>
    <br>

    <label class="new-row stat-name">{{localize "PEN.gender"}}</label>
    <input data-handle-change class="stat-name centre" type="text" value="{{localize 'PEN.male'}}" name="gender1">
    <div></div>
    <input data-handle-change class="stat-name centre" type="text" value="{{localize 'PEN.female'}}" name="gender2">
    <br>

    <label class="new-row stat-name">{{localize "PEN.born"}}</label>
    <input data-handle-change class="stat-name centre" type="number" value=462 name="born1">
    <div></div>
    <input data-handle-change class="stat-name centre" type="number" value=462 name="born2">
    <br>

    <label class="new-row stat-name">{{localize "PEN.died"}}</label>
    <input data-handle-change class="stat-name centre" type="number" value="" name="died1">
    <div></div>
    <input data-handle-change class="stat-name centre" type="number" value="" name="died2">
    <br>

    <label class="new-row stat-name">{{localize "PEN.knight"}}</label>
    <input data-handle-change class="stat-name centre" type="checkbox" {{checked formData.knight1}} name="knight1">
    <div></div>
    <input data-handle-change class="stat-name centre" type="checkbox" {{checked formData.knight2}} name="knight2">
    <br>
  </div>


</section>
