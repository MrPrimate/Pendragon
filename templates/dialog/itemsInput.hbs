<section class="Pendragon stats-input" id="stats-input-form">
  <br>

  <div class="stat-name stats-input">{{localize 'PEN.statsSpend'}}</div>
  <br>

  <div class="flexcol">
    <div class='bold statsCreate header counter'>
      <label class="stat-name skill-opt-label">{{ localize 'PEN.pointsSpent' }}:</label>
      <span class="stat-name centre count">{{added}}</span>
      <span class="stat-name centre">/</span>
      <span class="stat-name centre">{{pointsMax}}</span>
    </div>
    <br>

  <div class="statsCreate">
    {{#each traits as |trait key|}}
      <div class="bold stat-name new-row">{{trait.name}}</div>
      <div class="centre" style="padding-top: 8px;"><a class="targetIcon darkred up rollable inc-{{key}}" data-set="{{key}}">{{#if (lt trait.value trait.maxVal)}}<i class="fas fa-circle-up"></i>{{/if}}</a></div>
      <div class="stat-name centre item-{{key}}">{{trait.value}}</div>
      <div class="centre" style="padding-top: 8px;"><a class="targetIcon darkred down rollable dec-{{key}}" data-set="{{key}}">{{#if (gt trait.value trait.minVal)}}<i class="fas fa-circle-down"></i>{{/if}}</a></div>
    {{/each}}
  </div>

</section>
