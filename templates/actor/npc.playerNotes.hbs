<section class="npc-playerNotes-section {{#unless displayPlayerNotes }}hide-enc-notes{{/unless}}">
  {{!--Notes Block --}}
    <div class="npc-name bold grey" style="padding-left:10px;">{{ localize "PEN.playerNotes" }}</div>
    <div class="npcv2-notes-doc">
      {{#if editable}}
        <prose-mirror name="system.playerNotes" value="{{system.playerNotes}}" editable="{{editable}}" toggled="false">
          {{{enrichedPlayerNotes}}}
        </prose-mirror>
      {{else}}
        {{{enrichedPlayerNotes}}}
      {{/if}}
    </div>



</section>
