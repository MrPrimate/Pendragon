<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="effects">
    <h2>{{localize 'PEN.conditions'}}</h2>
    <ul class="conditions">
    {{#each conditions}}
      <li data-effect-id="{{ id }}">
        <label>
        <input type="checkbox" data-action="toggleCondition" {{#if active}}checked{{/if}}/>
        <img src="{{img}}" class="icon-img" />
        <span>{{ name }}</span>
        </label>
      </li>
    {{/each}}
    </ul>
    <h2>{{localize 'PEN.activeEffects'}} <button class="inline-control icon fa-regular fa-square-plus" data-action="addEffect"></button></h2>
    <ul class="effects">
    {{#each effects}}
      <li data-effect-id="{{ id }}" data-effect-uuid="{{ uuid }}">
        <span>{{ name }} {{#if item}}[{{ sourceLabel }}]{{/if}}</span>
        <button class="inline-control icon fa-regular fa-pen-to-square" data-action="editEffect"></button>
        <button class="inline-control icon fa-regular fa-trash" data-action="removeEffect"></button>
      </li>
    {{/each}}
    </ul>
</section>
