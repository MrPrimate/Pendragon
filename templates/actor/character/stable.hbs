<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="stable">
<h2>{{localize 'PEN.horseReadied'}}</h2>
<p>{{localize 'PEN.horseReadiedHint'}}</p>
  {{#each horses as |horse key|}}
    <div class="horse">
      <h3>
        <span>{{#if (eq horse.system.label horse.name)}}{{localize 'PEN.unnamed'}} {{/if}}{{horse.system.label}}</span>
        <span>{{horse.name}}{{#if horse.system.combat}} - {{localize 'PEN.warTrained'}}{{/if}}</span>
      </h3>
      <div style="display:flex; gap: 0.5lh;">
    <img class="horse-img" src="{{horse.img}}" data-tooltip="{{horse.name}}" style="width:64px;height:auto;background-color: #0004;"/>
    <div style="flex:auto;">
      <div class="flexrow">
        <p>{{localize 'PEN.hp'}}: {{horse.system.hp}} / {{horse.system.maxHP}}</p>
        <p>{{localize 'PEN.move'}}: {{horse.system.move}}</p>
        <p>{{localize 'PEN.armour'}}: {{horse.system.armour}}</p>
      </div>
      <div class="flexrow">
        <p>{{localize 'PEN.age'}}: {{horse.system.age}}</p>
        <p>{{localize 'PEN.colour'}}: {{horse.system.colour}}</p>
        <p>{{localize 'PEN.breed'}}: {{horse.system.breed}}</p>
      </div>
      <p>{{localize 'PEN.personality'}}: {{horse.system.personality}}</p>
      {{#if (eq horse._id ../currentHorse._id)}}<p>{{localize 'PEN.horseCurrent'}}</p>{{/if}}
      </div>
    </div>

    </div>
  {{/each}}
<h2>{{localize 'PEN.horseAvailable'}}</h2>
<p>{{localize 'PEN.horseAvailableHint'}}</p>
</section>
