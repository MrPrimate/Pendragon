<header class="Pendragon {{cssClass}} manor draggable" autocomplete="off">
  <section class="main-sheet">
    <section class="title-section">
      {{!-- Characteristics Header --}}
        <div class="charname-input" style="grid-column: 1 / span 2"><input name="name" type="text" value="{{actor.name}}" placeholder="Name"/></div>
        {{!-- Image Section --}}
        <div class="sheet-header" style="justify-content: flex-end;">
          <img class="profile-img" data-action="editImage" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" height="70" width="70"/>
        </div>
        <div class="new-row">
        </div>


    </section>
  </section>
</header>

