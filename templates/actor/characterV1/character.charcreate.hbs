<section class='character tab charcreat {{tab.cssClass}}' data-group='primary' data-tab='charcreate'>
  <br>
  <ol class="create-list">
    <li class="charcreate">
        <div class="stat-name bold">{{localize 'PEN.creation'}}</div>
        <div class="stat-name centre bold">{{localize 'PEN.status'}}</div>
        <div class="stat-name centre bold">{{localize 'PEN.activate'}}</div>
        <div class="stat-name centre bold">{{localize 'PEN.reset'}}</div>
        <div class="stat-name centre bold">{{localize 'PEN.notes'}}</div>
    </li>

    {{! - Creation Method}}
    <li class="charcreate" data-step="createMethod">
        <div class="stat-name">{{localize 'PEN.step.createMethod'}}</div>
        {{#if (eq system.create.step 1)}}
          <div class="stat-name centre" data-tooltip="{{localize 'PEN.incomplete'}}"><a class=""><i class="darkred fas fa-shield-xmark"></i></a></div>
          <div class="stat-name centre" data-action="charCreate"><a class="darkred"><i class="fas fa-circle-exclamation"></i></a></div>
          <div class="stat-name centre"><a class="fade"><i class="fas fa-broom"></i></a></div>
          <div class="stat-name centre"></div>
          <div class="stat-name centre" data-tooltip="{{localize 'PEN.constructionHint'}}"><a class=""><i class="darkred fas fa-shield-exclamation"></i></a></div>
        {{else}}
          <div class="stat-name centre" data-tooltip="{{localize 'PEN.completed'}}"><a class=""><i class="result-success fas fa-shield-check"></i></a></div>
          <div class="stat-name centre"><a class="fade"><i class="fas fa-circle-exclamation"></i></a></div>
          <div class="stat-name centre" data-action="charDelete" data-tooltip="{{localize 'PEN.resetHint'}}"><a><i class="fas fa-broom"></i></a></div>
          {{#if system.create.random}}
            <div class="stat-name centre bold">{{localize 'PEN.random'}}</div>
          {{else}}
            <div class="stat-name centre bold">{{localize 'PEN.constructed'}}</div>
          {{/if}}
          <div class="stat-name centre" data-tooltip="{{localize 'PEN.constructionHint'}}"><a class=""><i class="darkred fas fa-shield-exclamation"></i></a></div>
        {{/if}}
    </li>

