<section class='character tab stats {{tab.cssClass}}' data-group='primary' data-tab='stats'>
  <ol class="stats-list">
    <div class="stats-tab-grid">
      <div class="stat-item bold centre grid-item-left grid-item-top" data-tooltip="{{localize 'PEN.statistic'}}">{{ localize 'PEN.statAbbr'}}</div>
      <div class="stat-item bold centre grid-item-top" data-tooltip="{{localize 'PEN.base'}}">{{ localize 'PEN.baseAbbr'}}</div>
      <div class="stat-item bold centre grid-item-top" data-tooltip="{{localize 'PEN.culture'}}">{{ localize 'PEN.cultureAbbr'}}</div>
      <div class="stat-item bold centre grid-item-top" data-tooltip="{{localize 'PEN.training'}}">{{ localize 'PEN.trainingAbbr'}}</div>
      <div class="stat-item bold centre grid-item-top" data-tooltip="{{localize 'PEN.poison'}}">{{ localize 'PEN.poisonAbbr'}}</div>
      <div class="stat-item bold centre grid-item-top" data-tooltip="{{localize 'PEN.disease'}}">{{ localize 'PEN.diseaseAbbr'}}</div>
      <div class="stat-item bold centre grid-item-top"  data-tooltip="{{localize 'PEN.sol'}}">{{ localize 'PEN.solAbbr'}}</div>
      <div class="stat-item bold centre grid-item-top"  data-tooltip="{{localize 'PEN.mjrWnd'}}">{{ localize 'PEN.mjrWndAbbr'}}</div>
      <div class="stat-item bold centre grid-item-top" data-tooltip="{{localize 'PEN.aging'}}">{{ localize 'PEN.agingAbbr'}}</div>
      <div class="stat-item bold centre grid-item-top" data-tooltip="{{localize 'PEN.youth'}}">{{ localize 'PEN.youthAbbr'}}</div>
      <div class="stat-item bold centre grid-item-top" data-tooltip="{{localize 'PEN.winterPhase'}}">{{ localize 'PEN.winterAbbr'}}</div>
      <div class="stat-item bold centre grid-item-top" data-tooltip="{{localize 'PEN.effects'}}">{{ localize 'PEN.effects'}}</div>
      <div class="stat-item bold centre grid-item-top" data-tooltip="{{localize 'PEN.total'}}">{{ localize 'PEN.totalAbbr'}}</div>
      <div class="stat-item bold centre grid-item-top" data-tooltip="{{localize 'PEN.max'}}">{{ localize 'PEN.maxAbbr'}}</div>
      {{#if isCreation}}
        <div class="centre"><a class="large-icon {{#if actor.system.create.stats}}result-fail{{else}}fade{{/if}}" data-action="statRoll"><i title="{{localize 'PEN.roll'}}" class="fas fa-dice"></i></a></div>
      {{/if}}

      {{#each system.stats as |stat key|}}
        <div class="stat-item centre grid-item-left new-row">{{stat.labelShort}}</div>
        {{#isOr ../isGM ../isCreation}}
          <div class="stat-item-input centre grid-item-bottom"><input name="system.stats.{{key}}.value" type="number" value="{{stat.value}}"/></div>
          <div class="stat-item-input centre grid-item-bottom"><input name="system.stats.{{key}}.culture" type="number" value="{{stat.culture}}"/></div>
          <div class="stat-item-input centre grid-item-bottom"><input name="system.stats.{{key}}.create" type="number" value="{{stat.create}}"/></div>
          {{#if (eq key 'con')}}
            <div class="stat-item-input centre grid-item-bottom"><input name="system.stats.{{key}}.poison" type="number" value="{{stat.poison}}"/></div>
          {{else}}
            <div class="stat-item centre grid-item-bottom">-</div>
          {{/if}}
          <div class="stat-item-input centre grid-item-bottom"><input name="system.stats.{{key}}.disease" type="number" value="{{stat.disease}}"/></div>
          <div class="stat-item-input centre grid-item-bottom"><input name="system.stats.{{key}}.sol" type="number" value="{{stat.sol}}"/></div>
          <div class="stat-item-input centre grid-item-bottom"><input name="system.stats.{{key}}.major" type="number" value="{{stat.major}}"/></div>
          <div class="stat-item-input centre grid-item-bottom"><input name="system.stats.{{key}}.age" type="number" value="{{stat.age}}"/></div>
          <div class="stat-item centre grid-item-bottom">{{stat.youth}}</div>
          <div class="stat-item-input centre grid-item-bottom"><input name="system.stats.{{key}}.winter" type="number" value="{{stat.winter}}"/></div>
          <div class="stat-item centre grid-item-bottom">{{stat.effects}}</div>
        {{else}}
          <div class="stat-item centre grid-item-bottom">{{stat.value}}</div>
          <div class="stat-itemt centre grid-item-bottom">{{stat.culture}}</div>
          <div class="stat-item centre grid-item-bottom">{{stat.create}}</div>
          {{#if (eq key 'con')}}
            <div class="stat-item-input centre grid-item-bottom"><input name="system.stats.{{key}}.poison" type="number" value="{{stat.poison}}"/></div>
          {{else}}
            <div class="stat-item centre grid-item-bottom">-</div>
          {{/if}}
          <div class="stat-item-input centre grid-item-bottom"><input name="system.stats.{{key}}.disease" type="number" value="{{stat.disease}}"/></div>
          <div class="stat-item centre grid-item-bottom">{{stat.sol}}</div>
          <div class="stat-item centre grid-item-bottom">{{stat.major}}</div>
          <div class="stat-item centre grid-item-bottom">{{stat.age}}</div>
          <div class="stat-item centre grid-item-bottom">{{stat.youth}}</div>
          <div class="stat-item centre grid-item-bottom">{{stat.winter}}</div>
          <div class="stat-item centre grid-item-bottom">{{stat.effects}}</div>
        {{/isOr}}
        <div class ="stat-item centre bold grid-item-bottom" title="{{stat.labelShort}}">{{stat.total}}</div>
        <div class ="stat-item centre grid-item-bottom">{{stat.tMax}}</div>
      {{/each}}
      <div class="stat-item bold centre grid-item-bottom grid-item-left new-row"  data-tooltip="{{localize 'PEN.total'}}" >{{ localize 'PEN.totalAbbr'}}</div>
      <div class="stat-item bold centre grid-item-bottom">{{system.statTotal}}</div>
    </div>
  </ol>
    <br>

    <div class="adj-grid">
        <div class="stat-item">{{localize 'PEN.hpAdj'}}</div>
        <div class="stat-item">{{system.hp.adj}}</div>
        <div class="stat-item">{{localize 'PEN.damAdj'}}</div>
        <div class="stat-item">{{system.damAdj}}</div>
        <div class="stat-item">{{localize 'PEN.moveAdj'}}</div>
        <div class="stat-item">{{system.moveAdj}}</div>
        <div class="stat-item">{{localize 'PEN.armourAdj'}}</div>
        <div class="stat-item">{{system.armourAdj}}</div>
        <div class="stat-item">{{localize 'PEN.sizIncLabel'}}</div>
        <div class="stat-item">{{system.stats.siz.growth}}</div>
    </div>
  <br>
</section>
