<section class='character tab history {{tab.cssClass}}' data-group='primary' data-tab='history'>
  <div class="history-grid">
    <div class="stat-name bold grid-item-bottom centre">{{ localize "PEN.year" }}</div>
    <div class="stat-name bold grid-item-bottom">{{ localize "PEN.event" }}</div>
    <div class="stat-name bold grid-item-bottom centre">{{ localize "PEN.glory" }}</div>
    <div class="stat-name bold grid-item-bottom centre" data-action="createDoc" data-document-class='Item' data-type="history">
      <a class="large-icon" data-tooltip="{{localize 'PEN.addHistory'}}"><i class="item-control fas fa-plus"></i></a>
    </div>

    {{#if manualGlory}}
      <div class="grid-item-bottom stat-name centre"></div>
      <div class="grid-item-bottom stat-name">{{localize 'PEN.Settings.manualGlory'}}</div>
      <div class="grid-item-bottom dam-name-input centre"><input name="system.manualGlory" type="number" value="{{system.manualGlory}}"/></div>
      <div class="item grid-item-bottom centre"></div>
    {{/if}}

    {{#each history as |historical key|}}
      <div class="grid-item-bottom stat-name centre">{{historical.system.year}}</div>
      <div class="grid-item-bottom stat-name">{{historical.name}}</div>
      <div class="grid-item-bottom stat-name centre">{{historical.system.glory}}</div>
      <div class="item grid-item-bottom centre" data-itemid ="{{historical._id}}">
        <a class="item-control large-icon fade" data-action="viewDoc"><i data-tooltip="{{localize 'PEN.view'}}" class="fa-solid fa-eye"></i></a>
        {{#unless ../system.lock}}
          <a class="item-control fade large-icon" data-action="deleteDoc"><i data-tooltip="{{localize 'PEN.delete'}}" class="fas fa-broom-wide"></i></a>
        {{/unless}}
      </div>
    {{/each}}
  </div>
  <br>

  <div class="stat-name bold">{{localize 'PEN.equestrian'}}</div>
  <div class="equestrian-input"><input name="system.equestrian" type="text" value="{{actor.system.equestrian}}"/></div>

  <br>
  <div class="stat-name bold">{{localize 'PEN.joust'}}</div>
  <div class="joust-grid">
    <div class="stat-name">{{localize 'PEN.wins'}}</div>
    <div class="stat-name-input centre"><input name="system.joust.wins" type="number" value="{{actor.system.joust.wins}}"/></div>
    <div></div>
    <div class="stat-name">{{localize 'PEN.losses'}}</div>
    <div class="stat-name-input centre"><input name="system.joust.losses" type="number" value="{{actor.system.joust.losses}}"/></div>
    </div>


  <br>

  <div class="stat-name bold ">{{ localize "PEN.passive" }}</div>
  <div class="passive-grid">
    <div class="stat-name grid-item-bottom ">{{localize 'PEN.ideals'}}</div>
    <div class="stat-name grid-item-bottom centre">{{system.passglory.ideals}}</div>
    <div class="stat-name grid-item-bottom ">{{localize 'PEN.appeal'}}</div>
    <div class="stat-name grid-item-bottom centre">{{system.appeal}}</div>
    <div class="stat-name grid-item-bottom ">{{localize 'PEN.sol'}}</div>
    <div class="stat-name grid-item-bottom centre">{{system.solVal}}</div>
    <div class="stat-name grid-item-bottom ">{{localize 'PEN.sizInc.3'}}</div>
    <div class="stat-name grid-item-bottom centre">{{system.obese}}</div>
    <div class="stat-name grid-item-bottom ">{{localize 'PEN.tap'}}</div>
    <div class="stat-name grid-item-bottom centre">{{system.tap}}</div>
    <div class="stat-name grid-item-bottom ">{{localize 'PEN.estate'}}</div>
    <div class="armour-grid-input event-input grid-item-bottom centre"><input name="system.passglory.estate" type="number" value="{{system.passglory.estate}}"/></div>
    <div class="stat-name grid-item-bottom ">{{localize 'PEN.inyear'}}</div>
    <div class="armour-grid-input event-input grid-item-bottom centre"><input name="system.passglory.inyear" type="number" value="{{system.passglory.inyear}}"/></div>
    <div class="stat-name grid-item-bottom ">{{localize 'PEN.other'}}</div>
    <div class="armour-grid-input event-input grid-item-bottom centre"><input name="system.passglory.other" type="number" value="{{system.passglory.other}}"/></div>
    <div class="stat-name grid-item-bottom bold">{{localize 'PEN.totalG'}}</div>
    <div class="stat-name grid-item-bottom bold centre">{{system.passive}}</div>
  </div>
  <br>
</section>
