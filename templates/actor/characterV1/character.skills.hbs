<section class='character tab skills {{tab.cssClass}}' data-group='primary' data-tab='skills'>
  {{#unless isCreation}}
    <ol class="skill-list">
      {{#each skills as |skill key|}}
        <li class="item skill-listitem" data-drag='true' data-document-class='Item' data-item-id="{{skill._id}}">
          <div class="skill-grid {{#if skill.combat}}grey{{/if}}">
            <div class="centre"><a class="item-control item-toggle large-icon" data-itemid ="{{skill._id}}" data-property="XP" data-tooltip="{{localize 'PEN.dblClickToggle'}}"><i class="{{#if skill.system.XP}}fa-regular fa-square-check{{else}}fa-regular fa-square{{/if}}"></i></a></div>
            <div class="stat-name rollable skill-name {{#if skill.combat}}italics{{/if}} truncate" data-tooltip="{{localize 'PEN.rollHint'}}" data-itemid="{{skill._id}}">{{skill.name}}</div>
              <div class="stat-name centre">{{skill.system.total}}</div>
              <div class="centre item" data-itemid ="{{skill._id}}">
                <a class="large-icon item-control fade" data-action="viewDoc"><i data-tooltip="{{localize 'PEN.view'}}" class="fa-solid fa-eye"></i></a>
                {{#unless ../system.lock}}
                  <a class="item-control fade" data-action="deleteDoc"><i data-tooltip="{{localize 'PEN.delete'}}" class="fa-solid fa-broom-wide"></i></a>
                {{/unless}}
              </div>
          </div>
        </li>
      {{/each}}
    </ol>
  {{else}}
    <ol class="skill-dev-list">
      <div class="skill-dev-listitem">
        <div class="stat-name bold grid-item-top grid-item-left">{{localize 'PEN.skill'}}</div>
        <div class="stat-name bold centre grid-item-top">{{localize 'PEN.base'}}</div>
        <div class="stat-name bold centre grid-item-top">{{localize 'PEN.culture'}}</div>
        <div class="stat-name bold centre grid-item-top">{{localize 'PEN.family'}}</div>
        <div class="stat-name bold centre grid-item-top">{{localize 'PEN.training'}}</div>
        <div class="stat-name bold centre grid-item-top">{{localize 'PEN.winter'}}</div>
        <div class="stat-name bold centre grid-item-top">{{localize 'PEN.total'}}</div>
        <div class="centre"><a class="large-icon result-fail" data-action="genSkills"><i data-tooltip="{{localize 'PEN.genSkills'}}" class="fa-solid fa-rotate"></i></a></div>
      </div>

      {{#each skills as |skill key|}}
        <li class="item skill-dev-listitem" data-item-id="{{skill._id}}">
          <div class="stat-name truncate new-row grid-item-left" data-tooltip="{{skill.name}}">{{skill.name}}</div>
          <div class="stat-grid-input item centre grid-item-bottom" data-field="skill" data-att="value" data-itemid ="{{skill._id}}"><input class="inline-edit" name="skill.system.value" type="number" value="{{skill.system.value}}"/></div>
          <div class="stat-grid-input item centre grid-item-bottom" data-field="skill" data-att="culture" data-itemid ="{{skill._id}}"><input class="inline-edit" name="skill.system.culture" type="number" value="{{skill.system.culture}}"/></div>
          <div class="stat-grid-input item centre grid-item-bottom" data-field="skill" data-att="family" data-itemid ="{{skill._id}}"><input class="inline-edit" name="skill.system.family" type="number" value="{{skill.system.family}}"/></div>
          <div class="stat-grid-input item centre grid-item-bottom" data-field="skill" data-att="create" data-itemid ="{{skill._id}}"><input class="inline-edit" name="skill.system.create" type="number" value="{{skill.system.create}}"/></div>
          <div class="stat-grid-input item centre grid-item-bottom" data-field="skill" data-att="winter" data-itemid ="{{skill._id}}"><input class="inline-edit" name="skill.system.winter" type="number" value="{{skill.system.winter}}"/></div>
          <div class="stat-name centre grid-item">{{skill.system.total}}</div>
        </li>
      {{/each}}
    </ol>
  {{/unless}}
</section>
