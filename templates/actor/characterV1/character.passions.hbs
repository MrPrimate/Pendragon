<section class='character tab passions {{tab.cssClass}}' data-group='primary' data-tab='passions'>
  {{#unless isCreation}}
    <ol class="skill-list">
      {{#each passions as |passion key|}}
        <li class="item passion-grid" data-drag='true' data-document-class='Item' data-item-id="{{passion._id}}">
          {{#if (eq passion.system.level 0)}}
            {{#unless (eq passion.system.court 'adoratio')}}
              <br>
            {{/unless}}
            <div class="stat-name new-row bold passion-name {{#if (gt passion.system.total 40)}} result-success{{/if}}">{{passion.name}}</div>
            <div></div>
            <div class="stat-name centre {{#if (gt passion.system.total 40)}} result-success{{/if}}">{{passion.system.total}}</div>
            <div class="centre item">
              <a class="large-icon fade" data-action="createDoc" data-document-class='Item' data-type="passion" data-court="{{passion.system.court}}"><i data-tooltip="{{localize 'PEN.add'}}" class="fa-solid fa-plus"></i></a>
            </div>
          {{else}}
          {{#if (or (ne passion.system.total 0) (not ../system.lock))}}
            <div class="centre new-row"><a class="large-icon item-control item-toggle " data-itemid ="{{passion._id}}" data-property="XP" data-tooltip="{{localize 'PEN.dblClickToggle'}}"><i class="{{#if passion.system.XP}}fa-regular fa-square-check{{else}}fa-regular fa-square{{/if}}"></i></a></div>
            <div class="stat-name rollable passion-name" data-tooltip="{{localize 'PEN.rollHint'}}" data-itemid="{{passion._id}}">{{passion.name}}
              {{#if (ne passion.system.dishonour 0)}}
                [{{passion.system.dishonour}}]
              {{/if}}
            </div>
            <div class="stat-name centre" data-tooltip="{{passion.system.flavour}}">{{passion.system.total}}</div>
            <div class="centre item" data-itemid ="{{passion._id}}">
              <a class="large-icon item-control  fade" data-action="viewDoc"><i data-tooltip="{{localize 'PEN.view'}}" class="fa-solid fa-eye"></i></a>
              {{#unless ../system.lock}}
                <a class="large-icon item-control  fade" data-action="deleteDoc"><i data-tooltip="{{localize 'PEN.delete'}}" class="fa-solid fa-broom-wide"></i></a>
              {{/unless}}
            </div>
            {{/if}}
          {{/if}}
        </li>
      {{/each}}
    </ol>
  {{else}}
    <ol class="skill-dev-list">
      <div class="skill-dev-listitem">
        <div class="stat-name bold grid-item-top grid-item-left">{{localize 'PEN.passion'}}</div>
        <div class="stat-name bold centre grid-item-top">{{localize 'PEN.base'}}</div>
        <div class="stat-name bold centre grid-item-top">{{localize 'PEN.parent'}}</div>
        <div class="stat-name bold centre grid-item-top">{{localize 'PEN.homeland'}}</div>
        <div class="stat-name bold centre grid-item-top">{{localize 'PEN.winter'}}</div>
        <div class="stat-name bold centre grid-item-top">{{localize 'PEN.total'}}</div>
        <div class="stat-name bold centre grid-item-top">{{localize 'PEN.dishonour'}}</div>
      </div>

      {{#each passions as |passion key|}}
        {{#unless (eq passion.system.level 0)}}
        <li class="item skill-dev-listitem" data-item-id="{{passion._id}}">
          <div class="stat-name truncate new-row grid-item-left" data-tooltip="{{passion.name}}">{{passion.name}}</div>
          <div class="stat-grid-input item centre grid-item-bottom" data-field="passion" data-att="value" data-itemid ="{{passion._id}}"><input class="inline-edit" name="passion.system.value" type="number" value="{{passion.system.value}}"/></div>
          <div class="stat-grid-input item centre grid-item-bottom" data-field="passion" data-att="inherit" data-itemid ="{{passion._id}}"><input class="inline-edit" name="passion.system.inherit" type="number" value="{{passion.system.inherit}}"/></div>
          <div class="stat-grid-input item centre grid-item-bottom" data-field="passion" data-att="homeland" data-itemid ="{{passion._id}}"><input class="inline-edit" name="passion.system.homeland" type="number" value="{{passion.system.homeland}}"/></div>
          <div class="stat-grid-input item centre grid-item-bottom" data-field="passion" data-att="winter" data-itemid ="{{passion._id}}"><input class="inline-edit" name="passion.system.winter" type="number" value="{{passion.system.winter}}"/></div>
          <div class="stat-name centre grid-item-bottom">{{passion.system.total}}</div>
          {{#if passion.system.isHonour}}
            <div class="stat-grid-input item centre grid-item-top" data-field="passion" data-att="dishonour" data-itemid ="{{passion._id}}"><input class="inline-edit" name="passion.system.dishonour" type="number" value="{{passion.system.dishonour}}"/></div>
          {{/if}}
        </li>
        {{/unless}}
      {{/each}}
    </ol>
  {{/unless}}
</section>
