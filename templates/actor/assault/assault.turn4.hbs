<section class="tab turn4 {{tab.cssClass}}" data-group="primary" data-tab="turn4">
  {{!Open the Gate Turn}}
    <div class="centre bold">{{localize 'PEN.assault.turn4'}}</div>
      <div class="assault-turns">
        {{#if isGM}}
          <div class="enc-display"> {{localize 'PEN.assault.gateAP'}}</div>
          <div class="enc-input"><input class="centre" name='system.gateDoorAP' type='number' value='{{actor.system.gateDoorAP}}' /></div>
          <div class="enc-display"> {{localize 'PEN.assault.gateHP'}}</div>
          <div class="enc-input"><input class="centre" name='system.gateDoorHP' type='number' value='{{actor.system.gateDoorHP}}' /></div>
          <div class="enc-display"> {{localize 'PEN.assault.gateSTR'}}</div>
          <div class="enc-input"><input class="centre" name='system.gateDoorSTR' type='number' value='{{actor.system.gateDoorSTR}}' /></div>
          <div class="enc-display"> {{localize 'PEN.assault.timeLeft'}}</div>
          <div class="enc-input"><input class="centre" name='system.openGateRounds' type='number' value='{{actor.system.openGateRounds}}' /></div>
          <div class="new-row"></div>
          <div></div>
          <div class="enc-display">{{localize 'PEN.assault.rollRounds'}}</div>
          <div class="centre">
            <a data-action="rollGate">
              <i class="fas fa-dice"></i>
            </a>
          </div>
        {{else}}
          <div class="enc-display"> {{localize 'PEN.assault.gateAP'}}</div>
          <div class="enc-display centre">{{actor.system.gateDoorAP}}</div>
          <div class="enc-display"> {{localize 'PEN.assault.gateHP'}}</div>
          <div class="enc-display centre">{{actor.system.gateDoorHP}}</div>
          <div class="enc-display"> {{localize 'PEN.assault.gateSTR'}}</div>
          <div class="enc-display centre">{{actor.system.gateDoorSTR}}</div>
        {{/if}}
    </div>
    <br>
  <ol class="enc-list">
    <div class="battle-enc">
      <div class="horizontalboxed" data-coll="gatedefenders" style="padding-bottom:5px">
        <div class="enc-display bold" style="margin-top: 8px;">{{localize 'PEN.assault.castleDefenders'}}</div>
          {{#each gateDefenders as |enc id|}}
            <li class="partic-grid partic-item" data-property="{{enc.uuid}}" data-pid="{{enc.pid}}" data-coll="gatedefenders" data-index="{{@index}}">
              <div class="partic-cell truncate {{#if enc.actr.system.used}}strikethrough{{/if}}" data-action="viewEnc" data-tooltip="{{enc.actr.system.shortDesc}}">{{enc.name}}</div>
              {{#if ../isGM}}
                {{#if ../isLocked}}
                  <div></div>
                {{else}}
                  <div class="partic-cell centre" data-tooltip="{{localize 'PEN.deleteEnc'}}"><a data-action="deleteActr"><i class="fas fa-broom"></i></a></div>
                {{/if}}
              {{else}}
                <div></div>
              {{/if}}
            </li>
          {{else}}
            <div class="centre italics partic-item" data-coll="gatedefenders" style="height:30px; padding-top: 10px;">{{localize 'PEN.emptyList'}}</div>
          {{/each}}
        </div>
      </div>
  </ol>
</section>
