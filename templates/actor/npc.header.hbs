  <section class="">
    <section class="npc-title-section">
      {{!-- Characteristics Header --}}
        <div class=>
          <img class="profile-img" data-action='editImage' src="{{actor.system.coatOfArms}}" data-edit="system.coatOfArms" height="70" width="70"/>
        </div>
      <section class="sheet-header">
          <div class="npcname-input name-with-roll"><input name="name" type="text" value="{{actor.name}}" placeholder="Name"/>{{#if (and editable (not isLocked))}}<a class="random-name" data-action="randomName" data-tooltip="{{localize 'PEN.randomName'}}"><i class="black fas fa-dice"></i></a>{{/if}}</div>

        <div class="npc-grid">
          {{#if (gt ownershipLevel 1)}}
            {{#each system.stats as |stat key|}}
              <div class="npc-name centre bold rollable stat" data-stat="{{key}}">{{stat.labelShort}}</div>
            {{/each}}

            {{#each system.stats as |stat key|}}
              {{#if ../system.lock}}
                <div class="npc-name centre">{{stat.total}}</div>
              {{else}}
                <div class="npc-name-input centre"><input name="system.stats.{{key}}.value" type="number" value="{{stat.value}}" placeholder=10/></div>
              {{/if}}
            {{/each}}
          {{/if}}
        </div>
      </section>

      {{!-- Image Section --}}
      <section class="sheet-header">
        <img class="profile-img"  data-action='editImage' src="{{actor.img}}" data-edit="img" data-tooltip="{{actor.name}}" height="70" width="70"/>
      </section>

      {{!-- Icon Section --}}
      <section class="bottom sheet-header">
        {{#if (gt ownershipLevel 2)}}
          {{#if isGM}}
            <div class="centre middle-icon"><a data-action="noteView" data-tooltip="{{ localize 'PEN.toggleGMNotes' }}" ><i class="black fas fa-scroll-old"></i></a></div>
          {{else}}
            <div></div>
          {{/if}}
          <div class="centre middle-icon"><a data-action="playerNotesView" data-tooltip="{{ localize 'PEN.togglePlayerNotes' }}" ><i class="black fas fa-book-open"></i></a></div>
          {{#if system.lock}}
            <div><a class=""><i class="fas"></i></a></div>
          {{else}}
            {{#if isGM}}
              <div class="centre middle-icon"><a data-action="autoCalc" data-tooltip="{{ localize 'PEN.calcNPC' }}"> <i class="black fas fa-dice"></i></a></div>
            {{else}}
              <div></div>
            {{/if}}
          {{/if}}
        {{/if}}
      </section>
      <section class="bottom sheet-header">
        {{#if (gt ownershipLevel 2)}}
          <div class="centre middle-icon"><a data-action="actorToggle" data-tooltip="{{ localize 'PEN.lock' }}" data-property="lock"> <i class="black {{#if system.lock}}fas fa-lock{{else}}fas fa-lock-open{{/if}}"></i></a></div>
        {{else}}
          <div></div>
        {{/if}}
        <div><a class=""><i class="fas"></i></a></div>
        {{#if isGM}}
          <div class="centre middle-icon" data-action="baseStats"><a data-action="baseStats" data-tooltip="{{ localize 'PEN.baseStats' }}"> <i class="black fas fa-user"></i></a></div>
        {{/if}}
      </section>
    </section>
  </section>
