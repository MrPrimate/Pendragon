<section class="tab attributes {{tab.cssClass}}" data-group="primary" data-tab="attributes">
   <div class="helpicon">
    {{#if showHelp}}
      <a class="" data-action="openWiki" data-property="https://github.com/cragstone/Pendragon/wiki/History" data-tooltip='{{localize "PEN.openWiki"}}'>
        <i class="fas fa-circle-question"></i>
      </a>
    {{/if}}
  </div>
  <div class = "history-small-grid">
    <div class="stat-name left bold">{{localize 'PEN.year'}}</div>
    <div class="stat-name-input centre"><input name="system.year" type="number" value="{{item.system.year}}"/></div>
    <br>

    <div class="stat-name left bold new-row">{{localize 'PEN.glory'}}</div>
    <div class="stat-name-input centre"><input name="system.glory" type="number" value="{{item.system.glory}}"/></div>

    {{#if item.system.favour}}
      <br>
      <div class="stat-name left bold new-row">{{localize 'PEN.favourLevel'}}</div>
      <div class="stat-name-input centre"><input name="system.favourLevel" type="number" value="{{item.system.favourLevel}}"/></div>
    {{/if}}

  </div>
</section>

