<section class="tab attributes {{tab.cssClass}}" data-group="primary" data-tab="attributes">
  <br>
  <div class="item-trait-grid">
    <div class="stat-name left bold" data-tooltip="{{localize 'PEN.starterClassHint'}}">{{localize 'PEN.starterClass'}}</div>
    <div class="centre" style="padding-top: 8px;"><a class="item-control item-toggle large-icon" data-property = "starter" title="{{localize 'PEN.dblClickToggle'}}"><i class="{{#if item.system.starter}}fa-regular fa-square-check{{else}}fa-regular fa-square{{/if}}"></i></a></div>
    <div class="stat-name left bold" data-tooltip="{{localize 'PEN.ageClassHint'}}">{{localize 'PEN.age'}}</div>
    <div class="stat-name-input  centre"><input name="system.age" type="number" value="{{item.system.age}}"/></div>
  </div>
  <br>
  <div class="stat-name bold">{{ localize "PEN.passions"}}</div>
  {{!-- Primary Passions --}}
  <div class="horizontalboxed {{#if isGM}} droppable {{/if}} virtues" data-collection = "passions" data-section="primary">
    <div class="stat-name">{{ localize "PEN.primary"}}</div>
    <ol class="item-list">
      {{#each primary as |passion|}}
        <li class="item flexrow" data-item-id="{{passion.uuid}}" data-pid = "{{passion.flags.Pendragon.pidFlag.id}}" >
          <div class="item-name flexrow">
            {{#if passion.valid}}
              <div class="stat-name">{{passion.name}}</div>
            {{else}}
              <div class="stat-name result-success">{{passion.name}} [{{localize 'PEN.invalid'}}]</div>
            {{/if}}
          </div>
          <div class="item-controls" style="padding-top: 8px;">
            {{#if ../isGM}}
              <a class="item-control item-delete" title="{{localize 'PEN.deleteItem'}}" data-action="deleteItem"><i class="fas fa-trash"></i></a>
            {{/if}}
          </div>
        </li>
      {{else}}
          <div class="centre stat-name italics">{{localize 'PEN.emptyList'}}</div>
      {{/each}}
    </ol>
  </div>

  {{!-- Secondary Passions --}}
  <div class="horizontalboxed {{#if isGM}} droppable {{/if}} virtues" data-collection = "passions" data-section = "secondary">
    <div class="stat-name">{{ localize "PEN.secondary"}}</div>
    <ol class="item-list">
      {{#each secondary as |passion|}}
        <li class="item flexrow" data-item-id="{{passion.uuid}}" data-pid = "{{passion.flags.Pendragon.pidFlag.id}}" >
          <div class="item-name flexrow">
            {{#if passion.valid}}
              <div class="stat-name">{{passion.name}}</div>
            {{else}}
              <div class="stat-name result-success">{{passion.name}} [{{localize 'PEN.invalid'}}]</div>
            {{/if}}
          </div>
          <div class="item-controls" style="padding-top: 8px;">
            {{#if ../isGM}}
              <a class="item-control item-delete" title="{{localize 'PEN.deleteItem'}}" data-action="deleteItem"><i class="fas fa-trash"></i></a>
            {{/if}}
          </div>
        </li>
      {{else}}
          <div class="centre stat-name italics">{{localize 'PEN.emptyList'}}</div>
      {{/each}}
    </ol>
  </div>

  {{!-- Tertiary Passions --}}
  <div class="horizontalboxed {{#if isGM}} droppable {{/if}} virtues" data-collection = "passions" data-section = "tertiary">
    <div class="stat-name">{{ localize "PEN.tertiary"}}</div>
    <ol class="item-list">
      {{#each tertiary as |passion|}}
        <li class="item flexrow" data-item-id="{{passion.uuid}}" data-pid = "{{passion.flags.Pendragon.pidFlag.id}}" >
          <div class="item-name flexrow">
            {{#if passion.valid}}
              <div class="stat-name">{{passion.name}}</div>
            {{else}}
              <div class="stat-name result-success">{{passion.name}} [{{localize 'PEN.invalid'}}]</div>
            {{/if}}
          </div>
          <div class="item-controls" style="padding-top: 8px;">
            {{#if ../isGM}}
              <a class="item-control item-delete" title="{{localize 'PEN.deleteItem'}}" data-action="deleteItem"><i class="fas fa-trash"></i></a>
            {{/if}}
          </div>
        </li>
      {{else}}
          <div class="centre stat-name italics">{{localize 'PEN.emptyList'}}</div>
      {{/each}}
    </ol>
  </div>

</section>
