<section class="tab attributes {{tab.cssClass}}" data-group="primary" data-tab="attributes">
  <div class="helpicon">
    {{#if showHelp}}
      <a class="" data-action="openWiki" data-property="https://github.com/cragstone/Pendragon/wiki/Relationship" data-tooltip='{{localize "PEN.openWiki"}}'>
        <i class="fas fa-circle-question"></i>
      </a>
    {{/if}}
  </div>
  <div class="item-armour-grid">
    <div class="stat-name left bold">{{localize 'PEN.person1'}}</div>
    <div class="stat-name left">{{person1Name}}</div>
    <div class="stat-name left bold">{{localize 'PEN.person2'}}</div>
    <div class="stat-name left">{{person2Name}}</div>
    <br>
    <div class="stat-name left bold new-row">{{localize 'PEN.relationship'}}</div>
    <div class="stat-name-input left"><input name="system.connection" type="text" value="{{item.system.connection}}"/></div>
  </div>

</section>

