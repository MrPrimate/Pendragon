 <section class="tab attributes {{tab.cssClass}}" data-group="primary" data-tab="attributes">
  <div class="helpicon">
    {{#if showHelp}}
      <a class="" data-action="openWiki" data-property="https://github.com/cragstone/Pendragon/wiki/Estate-Improvements" data-tooltip='{{localize "PEN.openWiki"}}'>
        <i class="fas fa-circle-question"></i>
      </a>
    {{/if}}
  </div>
    <div class="item-improv-grid">
      <div class="stat-name left indent new-row">{{localize 'PEN.manor.impType'}}</div>
      {{#if canEdit}}
        <div class="stat-name centre">
          <select class="centre" data-handle-change name="system.subtype">
            {{selectOptions subType selected=item.system.subtype}}
          </select>
        </div>
      {{else}}
        <div class="stat-name centre">{{subLabel}}</div>
      {{/if}}
      <div class="stat-name left indent new-row">{{localize 'PEN.yearAvailable'}}</div>
      <div class="stat-name-input  centre"><input name="system.yearAvailable" type="number" value="{{item.system.yearAvailable}}"/></div>
      <div class="stat-name left indent new-row"></div>
      <div class="stat-name centre" >{{period}}</div>
      <div class="stat-name left indent new-row">{{localize 'PEN.manor.cost'}}{{localize 'PEN.manor.ld'}}</div>
      <div class="cost-grid">
        <div class="stat-name-input"><input class="centre" name="system.cost.libra" type="number" value="{{item.system.cost.libra}}"/></div>
        <div class="stat-name centre" style="padding-top: 3px;">/</div>
        <div class="stat-name-input  centre"><input class="centre" name="system.cost.denarii" type="number" value="{{item.system.cost.denarii}}"/></div>
      </div>
      {{#if hasOwner}}
        <div class="stat-name left indent new-row">{{localize 'PEN.manor.paidCost'}}</div>
        <div class="cost-grid">
          <div class="stat-name-input"><input class="centre" name="system.paid.libra" type="number" value="{{item.system.paid.libra}}"/></div>
          <div class="stat-name centre" style="padding-top: 3px;">/</div>
          <div class="stat-name-input  centre"><input class="centre" name="system.paid.denarii" type="number" value="{{item.system.paid.denarii}}"/></div>
        </div>
      {{/if}}

      <div class="stat-name left indent new-row">{{localize 'PEN.manor.repairCost'}}</div>
      <div class="cost-grid">
        <div class="stat-name-input"><input class="centre" name="system.repairCost.libra" type="number" value="{{item.system.repairCost.libra}}"/></div>
        <div class="stat-name centre" style="padding-top: 3px;">/</div>
        <div class="stat-name-input  centre"><input class="centre" name="system.repairCost.denarii" type="number" value="{{item.system.repairCost.denarii}}"/></div>
      </div>
      <div class="stat-name left indent new-row">{{localize 'PEN.manor.income'}}{{localize 'PEN.manor.ld'}}</div>
      <div class="cost-grid">
        <div class="stat-name-input"><input class="centre" name="system.income.libra" type="number" value="{{item.system.income.libra}}"/></div>
        <div class="stat-name centre" style="padding-top: 3px;">/</div>
        <div class="stat-name-input  centre"><input class="centre" name="system.income.denarii" type="number" value="{{item.system.income.denarii}}"/></div>
      </div>
      <div class="stat-name left indent new-row">{{localize 'PEN.manor.annualCost'}}{{localize 'PEN.manor.ld'}}</div>
      <div class="cost-grid">
        <div class="stat-name-input"><input class="centre" name="system.annualCost.libra" type="number" value="{{item.system.annualCost.libra}}"/></div>
        <div class="stat-name centre" style="padding-top: 3px;">/</div>
        <div class="stat-name-input  centre"><input class="centre" name="system.annualCost.denarii" type="number" value="{{item.system.annualCost.denarii}}"/></div>
      </div>

      {{#if (eq item.system.subtype 'def')}}
        <div class="stat-name left indent new-row">{{localize 'PEN.manor.dv'}}</div>
        <div class="stat-name-input  centre"><input name="system.dv.value" type="number" value="{{item.system.dv.value}}"/></div>
        <div class="stat-name left indent new-row"></div>
        <div class="stat-name centre">
          <select class="centre" data-handle-change name="system.dv.pos">
            {{selectOptions dvType selected=item.system.dv.pos}}
          </select>
        </div>
      {{/if}}

      {{#unless (eq system.subtype 'barInv')}}
        <div class="stat-name left indent">{{localize 'PEN.manor.starterImp'}}</div>
        <div class="stat-name centre"><a class="item-control item-toggle large-icon" data-property = "starter"><i class="{{#if item.system.starter}}fa-regular fa-square-check{{else}}fa-regular fa-square{{/if}}"></i></a></div>
      {{/unless}}

      {{#if showCheck}}
        <div class="stat-name left indent">{{localize 'PEN.manor.drawFunds'}}</div>
        <div class="stat-name centre"><a class="item-control item-toggle large-icon" data-property = "drawFunds"><i class="{{#if item.system.drawFunds}}fa-regular fa-square-check{{else}}fa-regular fa-square{{/if}}"></i></a></div>
      {{/if}}

      {{#if hasOwner}}
        <br>
        <div class="stat-name left indent new-row">{{localize 'PEN.manor.yearAcquired'}}</div>
        <div class="stat-name-input  centre"><input name="system.yearAcquired" type="number" value="{{item.system.yearAcquired}}"/></div>
        <div class="stat-name left indent new-row">{{localize 'PEN.status'}}</div>
        <div class="stat-name centre">
          <select class="centre" data-handle-change name="system.status">
            {{selectOptions maintList selected=item.system.status}}
          </select>
        </div>
      {{/if}}
    </div>
    <br>
    {{#if showCheck}}
      <div class="horizontalboxed {{#if isGM}} droppable {{/if}}" data-collection = "annchecks" >
        <div class="stat-name indent">{{ localize "PEN.manor.annualChecks"}}</div>
        <ol class="item-list">
          {{#each annualChecks as |check|}}
            <li class="item flexrow" data-item-id="{{check.uuid}}" data-opptest="{{check.name}}" data-pid = "{{check.flags.Pendragon.pidFlag.id}}" >
              <div class="item-name flexrow">
                {{#if check.valid}}
                  <div class="stat-name heading">{{check.name}} ({{check.typeLabel}})</div>
                {{else}}
                  <div class="stat-name result-success italics">{{check.name}} [{{localize 'PEN.invalid'}}]</div>
                {{/if}}
              </div>
              <div class="item-controls">
                {{#if ../isGM}}
                  <a class="item-control item-delete" title="{{localize 'PEN.deleteItem'}}" data-action="deleteItem"><i class="fas fa-trash"></i></a>
                {{/if}}
              </div>
            </li>
          {{else}}
            <div class="centre stat-name italics" style="height:60px;">{{localize 'PEN.emptyList'}}</div>
          {{/each}}
        </ol>
      </div>
      <br>
      <div class="horizontalboxed {{#if isGM}} droppable {{/if}}" data-collection = "optchecks" >
        <div class="stat-name indent">{{ localize "PEN.manor.optChecks"}}</div>
        <ol class="item-list">
          {{#each optChecks as |check|}}
              <li class="item flexrow" data-item-id="{{check.uuid}}" data-opptest="{{check.name}}" data-pid = "{{check.flags.Pendragon.pidFlag.id}}" >
                <div class="item-name flexrow">
                  {{#if check.valid}}
                    <div class="stat-name heading">{{check.name}} ({{check.typeLabel}})</div>
                  {{else}}
                    <div class="stat-name result-success">{{check.name}} [{{localize 'PEN.invalid'}}]</div>
                  {{/if}}
                </div>
                <div class="item-controls">
                  {{#if ../isGM}}
                    <a class="item-control item-delete" title="{{localize 'PEN.deleteItem'}}" data-action="deleteItem"><i class="fas fa-trash"></i></a>
                  {{/if}}
                </div>
              </li>
          {{else}}
            <div class="centre stat-name italics" style="height:60px;">{{localize 'PEN.emptyList'}}</div>
          {{/each}}
        </ol>
      </div>
      <br>
      <div class="horizontalboxed {{#if isGM}} droppable {{/if}}" data-collection = "annrolls" >
        <div class="stat-name indent">{{ localize "PEN.manor.annualRolls"}}</div>
        <ol class="item-list">
          {{#each annualRolls as |check|}}
              <li class="item flexrow" data-item-id="{{check.uuid}}" data-opptest="{{check.name}}" data-pid = "{{check.flags.Pendragon.pidFlag.id}}" >
                <div class="item-name flexrow">
                  {{#if check.valid}}
                    <div class="stat-name heading">{{check.name}} ({{check.typeLabel}})</div>
                  {{else}}
                    <div class="stat-name result-success">{{check.name}} [{{localize 'PEN.invalid'}}]</div>
                  {{/if}}
                </div>
                <div class="item-controls">
                  {{#if ../isGM}}
                    <a class="item-control item-delete" title="{{localize 'PEN.deleteItem'}}" data-action="deleteItem"><i class="fas fa-trash"></i></a>
                  {{/if}}
                </div>
              </li>
          {{else}}
            <div class="centre stat-name italics" style="height:60px;">{{localize 'PEN.emptyList'}}</div>
          {{/each}}
        </ol>
      </div>
      <br>
      <div class="horizontalboxed {{#if isGM}} droppable {{/if}}" data-collection = "optrolls" >
        <div class="stat-name indent">{{ localize "PEN.manor.optRolls"}}</div>
        <ol class="item-list">
          {{#each optRolls as |check|}}
              <li class="item flexrow" data-item-id="{{check.uuid}}" data-opptest="{{check.name}}" data-pid = "{{check.flags.Pendragon.pidFlag.id}}" >
                <div class="item-name flexrow">
                  {{#if check.valid}}
                    <div class="stat-name heading">{{check.name}} ({{check.typeLabel}})</div>
                  {{else}}
                    <div class="stat-name result-success">{{check.name}} [{{localize 'PEN.invalid'}}]</div>
                  {{/if}}
                </div>
                <div class="item-controls">
                  {{#if ../isGM}}
                    <a class="item-control item-delete" title="{{localize 'PEN.deleteItem'}}" data-action="deleteItem"><i class="fas fa-trash"></i></a>
                  {{/if}}
                </div>
              </li>
          {{else}}
            <div class="centre stat-name italics" style="height:60px;">{{localize 'PEN.emptyList'}}</div>
          {{/each}}
        </ol>
      </div>
    {{/if}}
    {{#if (eq system.subtype 'barInv')}}
      <div class="horizontalboxed {{#if isGM}} droppable {{/if}}" data-collection = "npcs" >
        <div class="stat-name indent">{{ localize "PEN.manor.court"}}</div>
        <ol class="item-list">
          {{#each folks as |folk|}}
            <li class="item flexrow" data-item-id="{{folk.uuid}}" data-pid = "{{folk.flags.Pendragon.pidFlag.id}}" >
              <div class="item-name flexrow">
                {{#if folk.valid}}
                  <div class="stat-name heading">{{folk.name}}</div>
                {{else}}
                  <div class="stat-name result-success italics">{{folk.name}} [{{localize 'PEN.invalid'}}]</div>
                {{/if}}
              </div>
              <div class="item-controls">
                {{#if ../isGM}}
                  <a class="item-control item-delete" title="{{localize 'PEN.deleteItem'}}" data-action="deleteItem"><i class="fas fa-trash"></i></a>
                {{/if}}
              </div>
            </li>
          {{else}}
            <div class="centre stat-name italics" style="height:60px;">{{localize 'PEN.emptyList'}}</div>
          {{/each}}
        </ol>
      </div>
      <br>
    {{/if}}
  </section>
