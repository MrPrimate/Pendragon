<div class="Pendragon tooltip">
  <header>
    <h2>{{ parent.name }}</h2>
    <ul class="pills"></ul>
  </header>
  {{{ description }}}
  <hr />
  <footer class="control-hints">
    <ul>
      <li><strong>Unopposed Roll: </strong><img src="systems/Pendragon/assets/Icons/mouse-left.svg" alt="Left Click" /></li>
      <li><strong>Opposed Roll: </strong><kbd>ALT</kbd> + <img src="systems/Pendragon/assets/Icons/mouse-left.svg" alt="Left Click" /></li>
      <li><strong>Fixed Opposed Roll: </strong><kbd>CTRL</kbd> + <img src="systems/Pendragon/assets/Icons/mouse-left.svg" alt="Left Click" /></li>
      <li><strong>Hide Prompt: </strong> Hold down <kbd>SHIFT</kbd> as well.</li>
    </ul>
  </footer>
</div>
