  <section >
    <div class = "wound-item-grid">
      <div class="stat-name bold">{{localize 'PEN.damage'}}</div>
      <div class="stat-name-input centre bottom dam-value"><input name="system.value" type="number" value="{{item.system.value}}"/></div>
      <div class="stat-name bold">{{localize 'PEN.damType'}}</div>
      <div class="stat-name centre">{{source}}</div>
      <div class="stat-name bold">{{localize 'PEN.description'}}</div>
      <div class="stat-name-input centre"><input name="system.description" type="text" value="{{item.system.description}}"/></div>
    </div>
    <div class="tabHelpIcon">
      {{#if showHelp}}
        <a class="helpicon" data-action="openWiki" data-property="https://github.com/cragstone/Pendragon/wiki/Wound" data-tooltip='{{localize "PEN.openWiki"}}'>
          <i class="fas fa-circle-question"></i>
        </a>
      {{/if}}
    </div>
  </section>
