
<section class="tab attributes {{tab.cssClass}}" data-group="primary" data-tab="attributes">

  {{#if hasOwner}}
    <div class="stat-name item-trait-grid">
      <div class="bold">{{localize 'PEN.idealMet'}}</div>
      <div class="centre">
        <a class="item-control item-toggle large-icon">
          <i class="{{#if item.system.activeIdeal}}fa-regular fa-square-check{{else}}fa-regular fa-square{{/if}}"></i>
        </a>
      </div>
      <div class="bold">{{localize 'PEN.joined'}}</div>
      <div class="centre">
        <a class="item-control large-icon" data-action="promoted" title="{{localize 'PEN.dblClickToggle'}}">
          <i class="{{#if item.system.promoted}}fa-regular fa-square-check{{else}}fa-regular fa-square{{/if}}"></i>
        </a>
      </div>
    </div>
  {{/if}}


  {{!-- Age Requirement --}}
    <div class="stat-name item-trait-grid">
      <div class="stat-name bold">{{ localize "PEN.age"}}</div>
      {{#if isGM}}
        <div class="stat-name-input centre"><input name="system.age" type="number" value="{{item.system.age}}"/></div>
      {{else}}
      <div class="stat-name centre">{{item.system.age}}</div>
      {{/if}}
    </div>


  {{!-- Trait Group --}}
    <div class="stat-name groupTitle">
      <div class="stat-name bold">{{ localize "PEN.traitGroup"}}</div>
      <div class="stat-name bold">{{ localize "PEN.required"}}</div>
      {{#if isGM}}
        <div class="stat-name-input centre"><input name="system.traitGroupScore" type="number" value="{{item.system.traitGroupScore}}"/></div>
      {{else}}
      <div class="stat-name centre">{{item.system.traitGroupScore}}</div>
      {{/if}}
    </div>
    <div class="horizontalboxed {{#if isGM}} droppable {{/if}}" data-collection = "traitGroup">
    <ol class="item-list">
      {{#each traitGroup as |trait|}}
        <li class="item flexrow" data-item-id="{{trait.uuid}}" data-pid = "{{trait.flags.Pendragon.pidFlag.id}}" >
          <div class="item-name flexrow">
            {{#if trait.valid}}
              <div class="stat-name">{{trait.name}}</div>
            {{else}}
              <div class="stat-name result-success">{{trait.name}} [{{localize 'PEN.invalid'}}]</div>
            {{/if}}
          </div>
          <div class="item-controls">
            {{#if ../isGM}}
              <a class="item-control item-delete" data-collection = "traitGroup" title="{{localize 'PEN.deleteItem'}}" data-action="deleteItem"><i class="fas fa-trash"></i></a>
            {{/if}}
          </div>
        </li>
      {{else}}
        <div class="centre italics" style="height:60px; padding-top: 20px;">{{localize 'PEN.emptyList'}}</td>
      {{/each}}
    </ol>
  </div>
  <br>

  {{!-- Skill Group --}}
    <div class="stat-name groupTitle">
      <div class="stat-name bold">{{ localize "PEN.skillGroup"}}</div>
      <div class="stat-name bold">{{ localize "PEN.numberRequired"}}</div>
      {{#if isGM}}
        <div class="stat-name-input centre"><input name="system.skillGroupCount" type="number" value="{{item.system.skillGroupCount}}"/></div>
      {{else}}
      <div class="stat-name centre">{{item.system.skillGroupCount}}</div>
      {{/if}}
    </div>
    <div class="horizontalboxed {{#if isGM}} droppable {{/if}}" data-collection = "skillGroup">
    <ol class="item-list">
      {{#each skillGroup as |skill|}}
        <li class="item flexrow" data-item-id="{{skill.uuid}}" data-pid = "{{skill.flags.Pendragon.pidFlag.id}}" >
          <div class="item-name flexrow">
            {{#if skill.valid}}
              <div class="stat-name">{{skill.name}}</div>
            {{else}}
              <div class="stat-name result-success">{{skill.name}} [{{localize 'PEN.invalid'}}]</div>
            {{/if}}
          </div>
          <div class="item-name flexrow">
            <div class="stat-name" >{{skill.score}}</div>
          </div>
          <div class="item-controls">
            {{#if ../isGM}}
              <a class="item-control item-delete" data-collection = "skillGroup" title="{{localize 'PEN.deleteItem'}}" data-action="deleteItem"><i class="fas fa-trash"></i></a>
            {{/if}}
          </div>
        </li>
      {{else}}
        <div class="centre italics" style="height:60px; padding-top: 20px;">{{localize 'PEN.emptyList'}}</td>
      {{/each}}
    </ol>
  </div>
  <br>



  {{!-- Requirements --}}
    <div class="stat-name bold">{{ localize "PEN.requirements"}}</div>
    <div class="horizontalboxed {{#if isGM}} droppable {{/if}} " data-collection = "require">
    <ol class="item-list">
      {{#each require as |requirement|}}
        <li class="item flexrow" data-item-id="{{requirement.uuid}}" data-pid = "{{requirement.flags.Pendragon.pidFlag.id}}" >
          <div class="item-name flexrow">
            {{#if requirement.valid}}
              <div class="stat-name">{{requirement.name}}</div>
            {{else}}
              <div class="stat-name result-success">{{requirement.name}} [{{localize 'PEN.invalid'}}]</div>
            {{/if}}
          </div>
          <div class="item-name flexrow">
            <div class="stat-name" >{{requirement.score}}</div>
          </div>
          <div class="item-controls">
            {{#if ../isGM}}
              <a class="item-control item-delete" data-collection = "require" title="{{localize 'PEN.deleteItem'}}" data-action="deleteItem"><i class="fas fa-trash"></i></a>
            {{/if}}
          </div>
        </li>
      {{else}}
        <div class="centre italics" style="height:60px; padding-top: 20px;">{{localize 'PEN.emptyList'}}</td>
      {{/each}}
    </ol>
  </div>
</section>
