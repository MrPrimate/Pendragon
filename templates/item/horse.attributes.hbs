<section class="tab attributes {{tab.cssClass}}" data-group="primary" data-tab="attributes">

        {{#if hasOwner}}
          <div class="item-horse-grid">
            <div class="stat-name left bold new-row">{{localize 'PEN.name'}}</div>
            <div class="stat-name-input left dam-value" style="grid-column: 2 / span 4;"><input name="system.horseName" type="text" value="{{item.system.horseName}}"/></div>
          </div>
        {{/if}}

        <div class = "warhorse-grid">
            <div class="stat-name left bold">{{localize 'PENDRAGON.StatSizAbbr'}}</div>
            <div class="stat-name-input centre dam-value"><input name="system.siz" type="number" value="{{item.system.siz}}" /></div>
            <div></div>
            <div class="stat-name left bold">{{localize 'PEN.armour'}}</div>
            <div class="stat-name-input centre dam-value"><input name="system.armour" type="number" value="{{item.system.armour}}" /></div>

            <div class="stat-name left bold">{{localize 'PENDRAGON.StatDexAbbr'}}</div>
            <div class="stat-name-input centre dam-value"><input name="system.dex" type="number" value="{{item.system.dex}}" /></div>
            <div></div>
            <div class="stat-name left bold">{{localize 'PEN.move'}}</div>
            <div class="stat-name-input centre dam-value"><input name="system.move" type="number" value="{{item.system.move}}" /></div>

            <div class="stat-name left bold">{{localize 'PENDRAGON.StatStrAbbr'}}</div>
            <div class="stat-name-input centre dam-value"><input name="system.str" type="number" value="{{item.system.str}}" /></div>
            <div></div>
            <div class="stat-name left bold">{{localize 'PEN.damage'}}</div>
            <div class="stat-name-input centre dam-value"><input name="system.damage" type="text" value="{{item.system.damage}}"/></div>

            <div class="stat-name left bold">{{localize 'PENDRAGON.StatConAbbr'}}</div>
            <div class="stat-name-input centre dam-value"><input name="system.con" type="number" value="{{item.system.con}}" /></div>
            <div></div>
            {{#if item.system.combat}}
              <div class="stat-name left bold">{{localize 'PEN.chargeDmg'}}</div>
              <div class="stat-name-input centre dam-value"><input name="system.chargeDmg" type="text" value="{{item.system.chargeDmg}}"/></div>
            {{/if}}

            <div class="stat-name left bold new-row">{{localize 'PEN.maxHP'}}</div>
            <div class="stat-name-input centre dam-value"><input name="system.maxHP" type="number" value="{{item.system.maxHP}}" /></div>
            <div></div>

          <div class="stat-name left bold">{{localize 'PEN.hpShort'}}</div>
          <div class="stat-name-input centre dam-value"><input name="system.hp" type="number" value="{{item.system.hp}}"/></div>

        </div>
      <br>

      <div class="item-horse-grid">
        <div class="stat-name left bold">{{localize 'PEN.combatTrained'}}</div>
        <div class="pad-icon"><a class="item-control {{#if isGM}} item-toggle {{/if}} large-icon" data-property = "combat" title="{{localize 'PEN.dblClickToggle'}}"><i class="{{#if item.system.combat}}fa-regular fa-square-check{{else}}fa-regular fa-square{{/if}}"></i></a></div>
        <div></div>
        <div class="stat-name left bold">{{localize 'PEN.special'}}</div>
        <div class="pad-icon"><a class="item-control {{#if isGM}} item-toggle {{/if}} large-icon" data-property = "special" title="{{localize 'PEN.dblClickToggle'}}"><i class="{{#if item.system.special}}fa-regular fa-square-check{{else}}fa-regular fa-square{{/if}}"></i></a></div>

        {{#if hasOwner}}
        <div class="stat-name left bold">{{localize 'PEN.ridden'}}</div>
          <div class="pad-icon"><a class="item-control item-toggle large-icon" data-property = "equipped" title="{{localize 'PEN.dblClickToggle'}}"><i class="{{#if item.system.equipped}}fa-regular fa-square-check{{else}}fa-regular fa-square{{/if}}"></i></a></div>
          <div></div>
          <div class="stat-name left bold">{{localize 'PEN.age'}}</div>
          <div class="stat-name-input left dam-value"><input name="system.age" type="number" value="{{item.system.age}}"/></div>

          <div class="stat-name left bold new-row">{{localize 'PEN.horseArmour'}}</div>
          <div class="stat-name-input left dam-value"><input name="system.horseArmour" type="number" value="{{item.system.horseArmour}}" /></div>
          <div></div>
          <div class="stat-name left bold">{{localize 'PEN.cost'}}</div>
          <div class="stat-name-input left dam-value"><input name="system.cost" type="text" value="{{item.system.cost}}"/></div>

          <div class="stat-name left bold">{{localize 'PEN.breed'}}</div>
          <div class="stat-name-input left dam-value"><input name="system.breed" type="text" value="{{item.system.breed}}"/></div>
          <div></div>
          <div class="stat-name left bold">{{localize 'PEN.colour'}}</div>
          <div class="stat-name-input left dam-value"><input name="system.colour" type="text" value="{{item.system.colour}}"/></div>

          <br>
          <div class="stat-name left bold new-row">{{localize 'PEN.health'}}</div>
          <div class="stat-name">
            <select data-handle-change name="system.horseHealth">
              {{selectOptions horseStatusList selected=item.system.horseHealth}}
            </select>
          </div>
          <div></div>
          <div class="stat-name left bold">{{localize 'PEN.care'}}</div>
          <div class="stat-name">
            <select data-handle-change name="system.horseCare">
              {{selectOptions horseStatusList selected=item.system.horseCare}}
            </select>
          </div>

          <div class="stat-name left bold" title="{{localize 'PEN.degradedHint'}}">{{localize 'PEN.degraded'}}</div>
          <div class="pad-icon"><a class="item-control item-toggle large-icon" data-property = "poor" title="{{localize 'PEN.dblClickToggle'}}"><i class="{{#if item.system.poor}}fa-regular fa-square-check{{else}}fa-regular fa-square{{/if}}"></i></a></div>

          <div class="new-row"></div>
          <br>
          <div class="stat-name left bold new-row">{{localize 'PEN.personality'}}</div>
          <div class="stat-name-input left dam-value" style="grid-column: 2 / span 4;"><input name="system.personality" type="text" value="{{item.system.personality}}"/></div>
          <div class="stat-name left bold new-row">{{localize 'PEN.features'}}</div>
          <div class="stat-name-input left dam-value" style="grid-column: 2 / span 4;"><input name="system.features" type="text" value="{{item.system.features}}"/></div>
         {{/if}}
      </div>
  </section>
