<section class="tab skills {{tab.cssClass}}" data-group="primary" data-tab="skills">
  <div class="helpicon">
    {{#if showHelp}}
      <a class="" data-action="openWiki" data-property="https://github.com/cragstone/Pendragon/wiki/Archetype" data-tooltip='{{localize "PEN.openWiki"}}'>
        <i class="fas fa-circle-question"></i>
      </a>
    {{/if}}
  </div>

  {{!-- Skills --}}
  <div class="stat-name bold">{{ localize "PEN.skills"}}</div>
  <div class="horizontalboxed {{#if isGM}} droppable {{/if}} virtues" style="min-height: 20px;" data-collection = "skills">
    <ol class="item-list">
      {{#each skills as |skill|}}
        <li class="item flexrow" data-item-id="{{skill.uuid}}" >
          <div class="item-name flexrow">
            {{#if skill.valid}}
              <div class="stat-name">{{skill.name}}</div>
            {{else}}
              <div class="stat-name result-success">{{skill.name}} [{{localize 'PEN.invalid'}}]</div>
            {{/if}}
          </div>
          <div class="stat-name centre">{{skill.formula}}</div>
          <div class="item-controls">
            {{#if ../isGM}}
              <a class="item-control item-delete" title="{{localize 'PEN.deleteItem'}}" data-action="deleteItem"><i class="fas fa-trash" style="padding-top: 5px;"></i></a>
            {{/if}}
          </div>
        </li>
      {{else}}
        <div class="centre italics" style="height:60px; padding-top: 20px;">{{localize 'PEN.emptyList'}}</td>
      {{/each}}
    </ol>
  </div>
</section>
