<section class="tab attributes {{tab.cssClass}}" data-group="primary" data-tab="attributes">
  <div class="item-trait-grid">
    <div class="stat-name left bold">{{localize 'PEN.quantity'}}</div>
    <div class="stat-name-input left"><input name="system.quantity" type="text" value="{{item.system.quantity}}" ="Number"/></div>
  </div>

  <div class="money-grid">
    <div class="stat-name left bold">{{localize 'PEN.price'}}</div>
    <div class="stat-name-input left"><input name="system.libra" type="number" value="{{item.system.libra}}"/></div>
    <div class="stat-name left bold">/</div>
    <div class="stat-name-input left"><input name="system.denarii" type="number" value="{{item.system.denarii}}"/></div>
  </div>
</section>
