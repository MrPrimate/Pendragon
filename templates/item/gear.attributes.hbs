<section class="tab attributes {{tab.cssClass}}" data-group="primary" data-tab="attributes">
  <div class="money-grid">
    <div class="stat-name left bold">{{localize 'PEN.quantity'}}</div>
    <div class="stat-name-input left"><input  class="centre" name="system.quantity" type="number" value="{{item.system.quantity}}"/></div>

    <div class="stat-name left bold new-row">{{localize 'PEN.price'}}</div>
    <div class="stat-name-input "><input class="centre" name="system.libra" type="number" value="{{item.system.libra}}"/></div>
    <div class="stat-name centre bold">/</div>
    <div class="stat-name-input"><input class="centre" name="system.denarii" type="number" value="{{item.system.denarii}}"/></div>
  </div>
</section>
