<section class="tab attributes {{tab.cssClass}}" data-group="primary" data-tab="attributes">
   <div class="helpicon">
    {{#if showHelp}}
      <a class="" data-action="openWiki" data-property="https://github.com/cragstone/Pendragon/wiki/Culture" data-tooltip='{{localize "PEN.openWiki"}}'>
        <i class="fas fa-circle-question"></i>
      </a>
    {{/if}}
  </div>
  <div class="item-culture-grid">
    <div class="stat-name left bold">{{localize 'PEN.characteristic'}}</div>
    <div class="stat-name centre"> {{localize 'PEN.bonus'}}</div>

    {{#if isGM}}
      <div class="stat-name left bold">{{localize 'PENDRAGON.StatSiz'}}</div>
      <div class="stat-name-input centre"><input name="system.stats.siz.bonus" type="number" value="{{item.system.stats.siz.bonus}}"/></div>
      <div class="stat-name left bold">{{localize 'PENDRAGON.StatDex'}}</div>
      <div class="stat-name-input centre"><input name="system.stats.dex.bonus" type="number" value="{{item.system.stats.dex.bonus}}"/></div>
      <div class="stat-name left bold">{{localize 'PENDRAGON.StatStr'}}</div>
      <div class="stat-name-input centre"><input name="system.stats.str.bonus" type="number" value="{{item.system.stats.str.bonus}}"/></div>
      <div class="stat-name left bold">{{localize 'PENDRAGON.StatCon'}}</div>
      <div class="stat-name-input centre"><input name="system.stats.con.bonus" type="number" value="{{item.system.stats.con.bonus}}"/></div>
      <div class="stat-name left bold">{{localize 'PENDRAGON.StatApp'}}</div>
      <div class="stat-name-input centre"><input name="system.stats.app.bonus" type="number" value="{{item.system.stats.app.bonus}}"/></div>
    {{else}}
      <div class="stat-name left bold">{{localize 'PENDRAGON.StatSiz'}}</div>
      <div class="stat-name centre">{{item.system.stats.siz.bonus}}</div>
      <div class="stat-name left bold">{{localize 'PENDRAGON.StatDex'}}</div>
      <div class="stat-name centre">{{item.system.stats.dex.bonus}}</div>
      <div class="stat-name left bold">{{localize 'PENDRAGON.StatStr'}}</div>
      <div class="stat-name centre">{{item.system.stats.str.bonus}}</div>
      <div class="stat-name left bold">{{localize 'PENDRAGON.StatCon'}}</div>
      <div class="stat-name centre">{{item.system.stats.con.bonus}}</div>
      <div class="stat-name left bold">{{localize 'PENDRAGON.StatApp'}}</div>
      <div class="stat-name centre">{{item.system.stats.app.bonus}}</div>
    {{/if}}
  </div>
  <br>

  {{!-- Skills --}}
  <div class="stat-name bold">{{ localize "PEN.skills"}}</div>
  <div class="horizontalboxed {{#if isGM}} droppable {{/if}} virtues" style="min-height: 20px;" data-collection = "skills">
    <ol class="item-list">
      {{#each skills as |skill|}}
        <li class="item flexrow" data-item-id="{{skill.uuid}}" >
          <div class="item-name flexrow">
            {{#if skill.valid}}
              <div class="stat-name">{{skill.name}}</div>
            {{else}}
              <div class="stat-name result-success">{{skill.name}} [{{localize 'PEN.invalid'}}]</div>
            {{/if}}
          </div>
          <div class="item-controls">
            {{#if ../isGM}}
              <a class="item-control item-delete" data-tooltip="{{localize 'PEN.delete'}}" data-action="deleteItem"><i class="fas fa-trash"></i></a>
            {{/if}}
          </div>
        </li>
      {{else}}
        <div class="centre italics" style="height:60px; padding-top: 20px;">{{localize 'PEN.emptyList'}}</div>
      {{/each}}
    </ol>
  </div>
  <br>

  {{!-- Starting Religion Table --}}
  <div class="stat-name bold">{{ localize "PEN.religionTable"}}</div>
  <div class="horizontalboxed {{#if isGM}} droppable {{/if}} virtues" style="min-height: 20px;" data-collection = "religionTables">
    <ol class="item-list">
      {{#each religionTables as |religion|}}
        <li class="item flexrow" data-item-id="{{religion.uuid}}" data-table-uuid="{{religion.tableUuid}}">
          <div class="item-name flexrow">
            {{#if religion.valid}}
              <div class="stat-name">{{religion.name}}</div>
            {{else}}
              <div class="stat-name result-success">{{religion.name}} [{{localize 'PEN.invalid'}}]</div>
            {{/if}}
          </div>
          <div class="item-controls">
            {{#if religion.valid}}
              <a class="item-control" data-tooltip="{{localize 'PEN.view'}}" data-action="viewTable"><i class="fa-solid fa-eye"></i></a>
            {{/if}}
            {{#if ../isGM}}
              <a class="item-control item-delete" data-tooltip="{{localize 'PEN.delete'}}" data-action="deleteItem"><i class="fas fa-trash"></i></a>
            {{/if}}
          </div>
        </li>
      {{else}}
        <div class="centre italics" style="height:60px; padding-top: 20px;">{{localize 'PEN.emptyList'}}</div>
      {{/each}}
    </ol>
  </div>

  {{!-- Name Tables --}}
  {{#each nameTables as |nameTable|}}
    <br>
    <div class="stat-name bold">{{localize nameTable.label}}</div>
    <div class="horizontalboxed {{#if ../isGM}} droppable {{/if}} virtues" style="min-height: 20px;" data-collection="{{nameTable.collection}}">
      <ol class="item-list">
        {{#each nameTable.tables as |table|}}
          <li class="item flexrow" data-item-id="{{table.uuid}}" data-table-uuid="{{table.tableUuid}}">
            <div class="item-name flexrow">
              {{#if table.valid}}
                <div class="stat-name">{{table.name}}</div>
              {{else}}
                <div class="stat-name result-success">{{table.name}} [{{localize 'PEN.invalid'}}]</div>
              {{/if}}
            </div>
            <div class="item-controls">
              {{#if table.valid}}
                <a class="item-control" data-tooltip="{{localize 'PEN.view'}}" data-action="viewTable"><i class="fa-solid fa-eye"></i></a>
              {{/if}}
              {{#if @root.isGM}}
                <a class="item-control item-delete" title="{{localize 'PEN.delete'}}" data-action="deleteItem"><i class="fas fa-trash"></i></a>
              {{/if}}
            </div>
          </li>
        {{else}}
          <div class="centre italics" style="height:60px; padding-top: 20px;">{{localize 'PEN.emptyList'}}</div>
        {{/each}}
      </ol>
    </div>
  {{/each}}
</section>
