<section class="tab scrollable active">
  <input type="hidden" name="id" value="{{id}}">
  <div class="form-group">
    <div>{{{localize 'PEN.PIDFlag.summary' type=object.type}}}</div>
  </div>
  <div class="form-group">
    <label for="_existing">{{localize 'PEN.PIDFlag.key'}}:</label>
    <div class="form-value flexrow" style="column-gap: 8px;">
      {{#if existingKeys.length}}
        <select name="known">
          <option value="">{{localize 'PEN.PIDFlag.new'}}</option>
          {{selectOptions existingKeys selected=id localize=false}}
        </select>
      {{else}}
        <span style="flex: 0 0 auto;">{{idPrefix}}</span>
        <input type="text" name="_existing" value="{{_existing}}" data-prefix="{{idPrefix}}">
      {{/if}}
      {{#if editable}}
        <span style="flex: 0 0 auto;">
          <a data-tooltip="PEN.PIDFlag.guess" data-action="guess" data-guess="{{guessCode}}"><i class="fa-solid fa-wand-magic fa-fw"></i></a>
        </span>
      {{/if}}
    </div>
  </div>
  {{#if (and existingKeys.length (not isSystemID))}}
    <div class="form-group">
      <label>&nbsp;</label>
      <div class="form-value flexrow" style="column-gap: 8px;">
        <span style="flex: 0 0 auto;">{{idPrefix}}</span>
        <input type="text" name="_existing" value="{{_existing}}" data-prefix="{{idPrefix}}">
      </div>
    </div>
  {{/if}}
  <div class="form-group">
    <label for="lang">{{localize 'PEN.PIDFlag.language'}}:</label>
    <div class="form-value">
      <select name="lang">
        {{selectOptions supportedLanguages selected=lang localize=false}}
      </select>
    </div>
  </div>
  <div class="form-group">
    <label for="priority">{{localize 'PEN.PIDFlag.priority'}}:</label>
    <div class="form-value">
      <input type="number" style="width: 3rem;" name="priority" value="{{priority}}">
    </div>
  </div>

  <fieldset class="item-sheet-properties">
    <legend>{{localize 'PEN.PIDFlag.info'}}</legend>
    <label>{{localize 'PEN.PIDFlag.others'}}:</label>
    <div class="flexcol">
      <details>
        <summary>{{localize 'PEN.PIDFlag.documents-in-world' count=worldDuplicates}}{{#if warnDuplicateWorldPriority}} <span class="warning"><i class="darkred fa-solid fa-exclamation-triangle"></i>{{localize 'PEN.PIDFlag.error.duplicate'}}</span>{{/if}}</summary>
        <table>
          <thead>
            <tr>
              <td class="short-text">{{localize 'PEN.PIDFlag.priorShrt'}}</td>
              <td class="short-text">{{localize 'PEN.PIDFlag.lang'}}</td>
              <td>{{localize 'PEN.PIDFlag.link'}}</td>
              <td>{{localize 'PEN.PIDFlag.folder'}}</td>
            </tr>
          </thead>
          <tbody>
            {{#each worldDocumentInfo}}
              <tr>
                <td class="short-text">{{priority}}</td>
                <td class="short-text">{{lang}}</td>
                <td>{{{link}}}</td>
                <td>{{folder}}</td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </details>
      <details>
        <summary>{{localize 'PEN.PIDFlag.documents-in-compendiums' count=compendiumDuplicates}}{{#if warnDuplicateCompendiumPriority}} <span class="warning"><i class="darkred fa-solid fa-exclamation-triangle"></i>{{localize 'PEN.PIDFlag.error.duplicate'}}</span>{{/if}}</summary>
        <table>
          <thead>
            <tr>
              <td class="short-text">{{localize 'PEN.PIDFlag.priorShrt'}}</td>
              <td class="short-text">{{localize 'PEN.PIDFlag.lang'}}</td>
              <td>{{localize 'PEN.PIDFlag.link'}}</td>
              <td>{{localize 'COMPENDIUM.Name'}}</td>
            </tr>
          </thead>
          <tbody>
            {{#each compendiumDocumentInfo}}
              <tr>
                <td class="short-text">{{priority}}</td>
                <td class="short-text">{{lang}}</td>
                <td>{{{link}}}</td>
                <td>{{folder}}</td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </details>
    </div>
    <div class="form-group">
      <label>{{localize 'PEN.PIDFlag.foundry-id'}}:</label>
      <div class="form-value flexrow" style="column-gap: 8px;">
        <input type="text" value="{{document.id}}" readonly>
        <span style="flex: 0 0 auto;">
          <a data-tooltip="PEN.CopyToClipboard" data-action="copyToClip"><i class="fa-solid fa-copy fa-fw"></i></a>
        </span>
      </div>
    </div>
    <div class="form-group">
      <label>{{localize 'PEN.PIDFlag.foundry-uuid'}}:</label>
      <div class="form-value flexrow" style="column-gap: 8px;">
        <input type="text" value="{{document.uuid}}" readonly>
        <span style="flex: 0 0 auto;">
          <a data-tooltip="PEN.CopyToClipboard" data-action="copyToClip"><i class="fa-solid fa-copy fa-fw"></i></a>
        </span>
      </div>
    </div>
    {{#if id}}
      <div class="form-group">
        <label>{{localize 'PEN.PIDFlag.key'}}:</label>
        <div class="form-value flexrow" style="column-gap: 8px;">
          <input type="text" value="{{id}}" readonly>
          <span style="flex: 0 0 auto;">
            <a data-tooltip="PEN.CopyToClipboard" data-action="copyToClip"><i class="fa-solid fa-copy fa-fw"></i></a>
          </span>
        </div>
      </div>
    {{/if}}
    <div class="form-group">
      <label>{{localize 'PEN.PIDFlag.get-this-document'}}:</label>
      <div class="form-value flexrow" style="column-gap: 8px;">
        <input type="text" value="await fromUuid('{{document.uuid}}')" readonly>
        <span style="flex: 0 0 auto;">
          <a data-tooltip="PEN.CopyToClipboard" data-action="copyToClip"><i class="fa-solid fa-copy fa-fw"></i></a>
        </span>
      </div>
    </div>
    {{#if id}}
      <div class="form-group">
        <label>{{localize 'PEN.PIDFlag.get-document-like-this'}}:</label>
        <div class="form-value flexrow" style="column-gap: 8px;">
          <input type="text" value="await game.system.api.pid.fromPID('{{id}}', '{{lang}}')" readonly>
          <span style="flex: 0 0 auto;">
            <a data-tooltip="PEN.CopyToClipboard" data-action="copyToClip"><i class="fa-solid fa-copy fa-fw"></i></a>
          </span>
        </div>
      </div>
    {{/if}}
  </fieldset>
</section>
